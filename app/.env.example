NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://rental:rental@localhost:5432/rental_system
SESSION_COOKIE_NAME=rental_session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=480
DEMO_MODE=true
DEMO_OWNER_USERNAME=owner
DEMO_OWNER_PASSWORD=OwnerDemo!2026
DEMO_STAFF_USERNAME=staff
DEMO_STAFF_PASSWORD=StaffDemo!2026
# Hardening (Sprint 7)
APP_VERSION=0.1.0
BODY_LIMIT=256kb
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_MUTATION_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_TEN_MINUTES=5
# First Owner account (production seed only; never commit real values)
SEED_OWNER_USERNAME=owner
SEED_OWNER_NAME=Chu cua hang
SEED_OWNER_PASSWORD=replace-with-at-least-12-characters
