generator client {
  provider      = "prisma-client-js"
  // "native" serves local development; the Debian target is what the production image runs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum ContactType {
  PHONE
  EMAIL
}

enum CustomerTagCode {
  BLACKLIST
  VIP
  WATCHLIST
}

enum ContractStatus {
  CONFIRMED
  ACTIVE
  OVERDUE
  COMPLETED
  CANCELLED
}

enum ContractEventType {
  CREATED
  ACTIVATED
  EXTENDED
  SWAPPED
  OVERDUE
  CANCELLED
  COMPLETED
  LINE_RETURNED
  CHARGE_ADDED
  SETTLED
  PAYMENT_RECORDED
  REFUND_RECORDED
  DEPOSIT_REFUNDED
}

enum ReturnCondition {
  GOOD
  MAINTENANCE
  DAMAGED
}

enum ChargeKind {
  LATE_RETURN
  DAMAGE
  OTHER
  DISCOUNT
}

enum PaymentKind {
  PAYMENT
  REFUND
  DEPOSIT_REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum ExpenseCategory {
  MAINTENANCE
  FUEL
  INSURANCE
  REGISTRATION
  RENT
  UTILITIES
  SALARY
  OTHER
}

/// Sprint 11: cost inputs for straight-line depreciation; one record per vehicle.
model VehicleAcquisition {
  vehicleId        String   @id
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  purchasePriceVnd Int
  purchasedOn      DateTime @db.Date
  usefulLifeMonths Int
  salvageValueVnd  Int      @default(0)
  updatedById      String
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz
}

/// Sprint 11: append-only expense ledger (BR-09); a reversal row points at the original.
model Expense {
  id             String          @id @default(uuid())
  idempotencyKey String          @unique
  category       ExpenseCategory
  amountVnd      Int
  method         PaymentMethod
  paidOn         DateTime        @db.Date
  description    String
  reference      String          @default("")
  notes          String          @default("")
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  recordedById   String
  reversalOfId   String?         @unique
  reversalOf     Expense?        @relation("ExpenseReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversal       Expense?        @relation("ExpenseReversal")
  createdAt      DateTime        @default(now()) @db.Timestamptz

  @@index([paidOn])
  @@index([vehicleId, paidOn])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

/// Sprint 12: Owner-maintained damage price list; charges copy the price at the time of the charge.
model DamageItem {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  priceVnd  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Sprint 12: one cash shift at a time (partial unique index in the migration); close figures are frozen.
model CashShift {
  id              String          @id @default(uuid())
  openedById      String
  openedAt        DateTime        @default(now()) @db.Timestamptz
  openingFloatVnd Int
  status          CashShiftStatus @default(OPEN)
  closedById      String?
  closedAt        DateTime?       @db.Timestamptz
  expectedCashVnd Int?
  countedCashVnd  Int?
  varianceVnd     Int?
  note            String          @default("")

  @@index([openedAt])
  @@index([openedById, openedAt])
}

model Account {
  id           String    @id @default(uuid())
  username     String    @unique
  name         String
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  sessions     Session[]
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  csrfHash  String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([accountId])
  @@index([expiresAt])
}

model VehicleType {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  vehicles        Vehicle[]
  pricingVersions PricingVersion[]
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz
}

model Vehicle {
  id              String                 @id @default(uuid())
  code            String                 @unique
  plate           String
  normalizedPlate String                 @unique
  model           String
  color           String
  year            Int
  status          VehicleStatus          @default(AVAILABLE)
  typeId          String
  type            VehicleType            @relation(fields: [typeId], references: [id])
  statusHistory   VehicleStatusHistory[]
  contractLines   ContractVehicleLine[]
  acquisition     VehicleAcquisition?
  expenses        Expense[]
  createdAt       DateTime               @default(now()) @db.Timestamptz
  updatedAt       DateTime               @updatedAt @db.Timestamptz

  @@index([status])
  @@index([typeId])
}

model VehicleStatusHistory {
  id        String        @id @default(uuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  from      VehicleStatus
  to        VehicleStatus
  actorId   String
  reason    String
  createdAt DateTime      @default(now()) @db.Timestamptz

  @@index([vehicleId, createdAt])
}

model Customer {
  id          String             @id @default(uuid())
  name        String
  nationality String
  contacts    CustomerContact[]
  tags        CustomerTag[]
  documents   CustomerDocument[]
  contracts   Contract[]
  createdAt   DateTime           @default(now()) @db.Timestamptz
  updatedAt   DateTime           @updatedAt @db.Timestamptz

  @@index([name])
}

model CustomerContact {
  id              String      @id @default(uuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            ContactType
  value           String
  normalizedValue String
  primary         Boolean     @default(false)
  createdAt       DateTime    @default(now()) @db.Timestamptz

  @@index([normalizedValue])
  @@index([customerId])
}

model CustomerTag {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       CustomerTagCode
  reason     String
  createdAt  DateTime        @default(now()) @db.Timestamptz

  @@index([customerId])
}

model CustomerDocument {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  objectKey  String
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([customerId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  action     String
  actorId    String
  entityId   String
  entityType String
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model PricingVersion {
  id                      String                @id @default(uuid())
  typeCode                String
  vehicleType             VehicleType           @relation(fields: [typeCode], references: [code])
  version                 Int
  createdById             String
  lateReturnGraceMinutes  Int                   @default(60)
  lateReturnHourlyRateVnd Int                   @default(20000)
  tiers                   PricingTier[]
  lines                   ContractVehicleLine[]
  createdAt               DateTime              @default(now()) @db.Timestamptz

  @@unique([typeCode, version])
  @@index([typeCode, createdAt])
}

model PricingTier {
  id               String         @id @default(uuid())
  pricingVersionId String
  pricingVersion   PricingVersion @relation(fields: [pricingVersionId], references: [id], onDelete: Cascade)
  minDays          Int
  maxDays          Int?
  dailyRateVnd     Int
  createdAt        DateTime       @default(now()) @db.Timestamptz

  @@index([pricingVersionId, minDays])
}

model Contract {
  id                   String                @id @default(uuid())
  code                 String                @unique
  idempotencyKey       String                @unique
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id])
  customerNameSnapshot String
  status               ContractStatus        @default(CONFIRMED)
  deliveryFeeVnd       Int
  totalVnd             Int
  createdById          String
  activatedAt          DateTime?             @db.Timestamptz
  overdueSince         DateTime?             @db.Timestamptz
  completedAt          DateTime?             @db.Timestamptz
  cancelledAt          DateTime?             @db.Timestamptz
  cancelledById        String?
  cancellationReason   String?
  settledAt            DateTime?             @db.Timestamptz
  lines                ContractVehicleLine[]
  handover             ContractHandover?
  events               ContractEvent[]
  charges              ContractCharge[]
  settlement           ContractSettlement?
  payments             ContractPayment[]
  createdAt            DateTime              @default(now()) @db.Timestamptz

  @@index([customerId, createdAt])
  @@index([status])
}

model ContractVehicleLine {
  id                      String               @id @default(uuid())
  contractId              String
  contract                Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  vehicleId               String
  vehicle                 Vehicle              @relation(fields: [vehicleId], references: [id])
  pricingVersionId        String
  pricingVersion          PricingVersion       @relation(fields: [pricingVersionId], references: [id])
  startAt                 DateTime             @db.Timestamptz
  endAt                   DateTime             @db.Timestamptz
  billableDays            Int
  dailyRateVnd            Int
  baseSubtotalVnd         Int
  adjustmentPercent       Int
  finalSubtotalVnd        Int
  lateReturnGraceMinutes  Int                  @default(60)
  lateReturnHourlyRateVnd Int                  @default(20000)
  explanation             String
  overrideReason          String?
  blocksAvailability      Boolean              @default(true)
  replacesLineId          String?              @unique
  replaces                ContractVehicleLine? @relation("LineReplacement", fields: [replacesLineId], references: [id])
  replacedBy              ContractVehicleLine? @relation("LineReplacement")
  returnedAt              DateTime?            @db.Timestamptz
  returnedById            String?
  returnCondition         ReturnCondition?
  returnFuelPercent       Int?
  returnNotes             String?
  returnImageObjectKeys   String[]             @default([])
  charges                 ContractCharge[]
  createdAt               DateTime             @default(now()) @db.Timestamptz

  @@index([vehicleId, startAt, endAt])
  @@index([contractId])
}

model ContractEvent {
  id         String            @id @default(uuid())
  contractId String
  contract   Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type       ContractEventType
  actorId    String
  reason     String?
  metadata   Json?
  occurredAt DateTime          @db.Timestamptz
  createdAt  DateTime          @default(now()) @db.Timestamptz

  @@index([contractId, occurredAt])
}

model ContractCharge {
  id          String               @id @default(uuid())
  contractId  String
  contract    Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lineId      String?
  line        ContractVehicleLine? @relation(fields: [lineId], references: [id])
  vehicleCode String?
  kind        ChargeKind
  amountVnd   Int
  description String
  actorId     String
  metadata    Json?
  createdAt   DateTime             @default(now()) @db.Timestamptz

  @@index([contractId, createdAt])
}

model ContractSettlement {
  id                String   @id @default(uuid())
  contractId        String   @unique
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  settledById       String
  settledAt         DateTime @db.Timestamptz
  chargesVnd        Int
  discountsVnd      Int
  totalDueVnd       Int
  paidVnd           Int
  outstandingVnd    Int
  depositVnd        Int
  depositAppliedVnd Int
  refundVnd         Int
  receivableVnd     Int
  documentReturned  Boolean  @default(false)
  depositRefunded   Boolean  @default(false)
  notes             String   @default("")
  createdAt         DateTime @default(now()) @db.Timestamptz
}

/// Append-only payment ledger (BR-07): the API never updates or deletes a row.
model ContractPayment {
  id             String        @id @default(uuid())
  contractId     String
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  idempotencyKey String        @unique
  kind           PaymentKind
  method         PaymentMethod
  amountVnd      Int
  reference      String        @default("")
  notes          String        @default("")
  receivedById   String
  receivedAt     DateTime      @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz

  @@index([contractId, receivedAt])
  @@index([receivedAt])
}


model ContractHandover {
  id               String   @id @default(uuid())
  contractId       String   @unique
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  depositVnd       Int
  retainedDocument String
  deliveryPlace    String
  fuelPercent      Int
  notes            String
  imageObjectKeys  String[]
  createdAt        DateTime @default(now()) @db.Timestamptz
}
