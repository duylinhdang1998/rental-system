# ~/rental-system/.env on the host — generated by deploy/server-setup.sh, mode 0600.
# Never commit the real file. Compose reads TAG / WEB_PORT; the API reads the rest.
TAG=latest
WEB_PORT=8180
APP_VERSION=0.1.0

NODE_ENV=production
CORS_ORIGINS=https://rental.vfmtech.vn
DATABASE_URL=postgresql://rental:<generated>@global_postgres:5432/rental_system?schema=public
SESSION_COOKIE_NAME=rental_session
SESSION_SECRET=<generated-64-hex>
SESSION_TTL_MINUTES=480
DEMO_MODE=false

BODY_LIMIT=256kb
# host nginx -> web container nginx -> api: two proxies add X-Forwarded-For entries
TRUST_PROXY_HOPS=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_MUTATION_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_TEN_MINUTES=5
RATE_LIMIT_UPLOAD_PER_TEN_MINUTES=10
